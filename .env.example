# Public URL of this demo (metadata, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://demo.proofage.net

# Server-only: one entry per workspace, keyed by slug. The public key reaches the browser SDK
# through the page; the secret key signs API calls and verifies webhooks.
#   selfie, selfie-lumo   → selfie age check (ProofAge look, Lumo look)
#   age-id, age-id-lumo   → age check by ID, threshold 18
#   kyc, kyc-lumo         → identity verification (KYC), no age threshold
#   eudi-wallet           → the EUDI page (method: wallet): its own workspace, wallet offered first
PROOFAGE_DEMO_WORKSPACES={"selfie":{"apiKey":"pk_live_...","secretKey":"sk_live_..."},"selfie-lumo":{"apiKey":"pk_live_...","secretKey":"sk_live_..."},"age-id":{"apiKey":"pk_live_...","secretKey":"sk_live_..."},"age-id-lumo":{"apiKey":"pk_live_...","secretKey":"sk_live_..."},"kyc":{"apiKey":"pk_live_...","secretKey":"sk_live_..."},"kyc-lumo":{"apiKey":"pk_live_...","secretKey":"sk_live_..."},"eudi-wallet":{"apiKey":"pk_live_...","secretKey":"sk_live_..."}}

# Webhook storage and the session-creation rate limit (Upstash via the Vercel Marketplace).
# Unset in production: nothing is stored and the page says so. Unset in local dev: in-memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# true while recording: names, dates, places and document numbers are masked on the server.
DEMO_MASK_ALL=false

# Defaults baked into the code — only override for local dev or custom deployments:
# NEXT_PUBLIC_PROOFAGE_API_URL=https://api.proofage.net/v1
# NEXT_PUBLIC_PROOFAGE_SDK_URL=https://app.proofage.net/sdk-build/kyc-loader.js
# PROOFAGE_BASE_URL=https://api.proofage.net

# Optional: webhook timestamp tolerance (seconds)
PROOFAGE_WEBHOOK_TOLERANCE=300
